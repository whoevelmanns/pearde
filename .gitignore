__pycache__/
.claude/
*.pyc
.DS_Store
resources/board/state/
.gstack/
vicky/
.obsidian/

# this repo tracks its own prds/ board directly (unlike a board split out
# into its own local-only repo) -- override the machine-wide `prds/`
# ignore in ~/.gitignore_global, which exists for that other case
!prds/


# machine-local per board — regenerable
prds/.plan.json
prds/.round.md
prds/.history.jsonl
prds/.transitions.jsonl
prds/.claims/
prds/.view.html

# one-off session measurements, kept beside the work they explain
/report.md

# local npm install of playwright-core, so probe/verify.sh's NODE_PATH
# check can resolve it -- not a repo dependency, never committed
/node_modules/
/package.json
/package-lock.json
